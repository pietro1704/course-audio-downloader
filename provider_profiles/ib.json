{
  "schema": "course-site-profile/v1",
  "mode": "embedded-json",
  "origin": "https://sala.institutoborborema.com",
  "title_suffix_pattern": "\\s*-\\s*Instituto Borborema$",
  "links_selector": "a[href],audio,audio source",
  "auth_expression": "!!document.querySelector('a[href=\"/auth/logout\"]')",
  "lesson_path_pattern": "/area/conteudo/aula/\\d+",
  "active_selector": "a.layer-link",
  "active_title_selector": ".item-titulo",
  "player": {
    "host_pattern": "player-vz-[a-z0-9-]+\\.tv\\.pandavideo\\.com\\.br"
  },
  "prefer_audio_rendition": true,
  "data_path": [
    "props",
    "pageProps",
    "applicationData"
  ],
  "course": {
    "entry_path_pattern": "/area/conteudo/(?:aula|curso)/\\d+",
    "title_selector": ".course-name, .product-name, [data-course-title]",
    "title_from_module_pattern": "^Explicações sobre (?:a |o )?(.+)$",
    "fallback_to_origin": true,
    "links_selector": "a.layer-link",
    "lesson_title_selector": ".item-titulo",
    "duration_selector": ".duration",
    "module_selector": ".section-group",
    "module_title_selector": ".section-group-titulo .item-titulo"
  },
  "documents": {
    "links_selector": "a.article-attach",
    "items_expression": "[...document.querySelectorAll('a.article-attach[href]')].map(a=>{const u=new URL(a.href);const id=u.origin+u.pathname+'?'+[...u.searchParams].filter(([k])=>!['signature','t'].includes(k)).sort().map(([k,v])=>encodeURIComponent(k)+'='+encodeURIComponent(v)).join('&');const n=u.searchParams.get('n');return {id,url:a.href,name:n&&/\\.pdf$/i.test(n)?n:null,label:a.textContent.trim().replace(/\\s+/g,' ').replace(/\\s+[\\d.,]+\\s*[kmg]?b$/i,'')}})"
  }
}
