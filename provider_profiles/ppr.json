{
  "schema": "course-site-profile/v1",
  "mode": "direct",
  "origin": "https://padrepauloricardo.org",
  "activate_browser_tab": false,
  "title_selector": ".lesson-text__title",
  "links_selector": ".downloads-item__link",
  "auth_expression": "!!document.querySelector('.downloads-item__link[download]')",
  "lesson_path_pattern": "/aulas/[^/]+",
  "audio_label_pattern": "(?=.*(?:audio|áudio))(?=.*mp3)",
  "documents": {
    "links_selector": ".downloads-item__link",
    "items_expression": "[...document.querySelectorAll('.downloads-item__link[href]')].filter(a=>!/áudio|audio/i.test(a.innerText)).map(a=>{const u=new URL(a.href);const cd=u.searchParams.get('response-content-disposition')||'';const m=cd.match(/filename=\"([^\"]+)\"/);return {id:u.origin+u.pathname,url:a.href,name:m?m[1]:null,mime:/\\.pdf(?:$|[?])/i.test(m?.[1]||'')?'application/pdf':''}})"
  },
  "course": {
    "entry_path_pattern": "/(?:cursos|aulas)/[^/?#]+",
    "title_selector": ".banner__title, .lesson-text__theme",
    "links_selector": "a.class",
    "lesson_title_selector": ".class__title",
    "duration_selector": ".class__duration"
  }
}
